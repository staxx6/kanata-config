;; Caps Lock = hold for navigation layer

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  nav (layer-while-held navigation)
  deskleft C-M-left
  deskright C-M-rght
)

(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @nav a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer navigation
  _    _    _    _         _          _    _    _    _  _     _   _    _ caps
  _    _    up   @deskleft @deskright _    _    _    home  end     _   _    _    _
  _    left down right     esc        _    left down up right _   del  _
  _    _    _    _         _          _    _    _    _   _    _   _
  _    _    _                        bspc            _   _    _
)
